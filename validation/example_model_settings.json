{
   "name": "MyModelName",
   "description": "Longer model description",
   "model_supplier_id": "OasisLMF",
   "model_name_id": "piwind",
   "model_version_id": "1",
   "model_configurable": true,
   "model_default_samples": 10,

   "model_settings":{
      "event_set":{
         "name":"Event Set",
         "default":"P",
         "desc": "Lists of event sets",
         "options":[
            {
               "id":"P",
               "desc":"Probabilistic",
               "number_of_events": 1001,
               "valid_occurrence_ids":["1"],
               "valid_perspectives": ["gul", "il"],
               "valid_metrics": ["plt", "elt"]
            },
            {
               "id":"H",
               "desc":"Historical"
            }
         ]
      },
      "event_occurrence_id":{
         "name":"Occurrence Set",
         "desc":"PiWind Occurrence selection",
         "default":"1",
         "options":[
            {
               "id":"1",
               "desc":"Long Term",
               "max_periods": 10000
            }
         ]
      },
      "valid_output_perspectives": ["gul", "il"],
      "valid_output_metrics": ["ept", "psept"],
      "string_parameters":[
        {
            "name": "option_str",
            "desc": "Option for X, Y or Z",
            "default": "some_string"
        }
      ],
      "list_parameters":[
        {
            "name": "option_list",
            "desc": "list is for A or B",
            "default": ["str1", "str2"]
        }
      ],
      "dictionary_parameters":[
        {
            "name": "dictionary_option",
            "desc": "this Stores .. for ... etc",
            "default": {"k1":"v1", "k2":"v2"}
        }
      ],
      "boolean_parameters":[
         {
            "name":"peril_wind",
            "desc":"Boolean option",
            "default":false
         },
         {
            "name":"peril_surge",
            "desc":"Boolean option",
            "default":true
         }
      ],
      "float_parameters":[
         {
            "name":"float_1",
            "desc":"Some float value",
            "default":1.0,
            "max":1.0,
            "min":0.0
         },
         {
            "name":"float_2",
            "desc":"Some float value",
            "default":0.3,
            "max":1.0,
            "min":0.0
         }
      ],
      "numeric_parameters":[
        {
            "name":"numeric_val_1",
            "desc":"Some float value",
            "default": 4
        }
      ],
      "multi_parameter_options":[
        {
            "name": "location_dependent_config_option_1",
            "desc": "param group option 1",
            "config": {
                "parameter_name_a": "A_value",
                "parameter_name_b": ["B_value"],
                "parameter_name_c": true,
                "parameter_name_n": {"K1": "V1"}
            }
        },
        {
            "name": "location_dependent_config_option_2",
            "desc": "param group option 2",
            "config": {
                "parameter_name_a": "A_value_2",
                "parameter_name_b": ["B_value_2"],
                "parameter_name_c": false,
                "parameter_name_n": {"K2": "V2"}
            }
        }
      ],
      "parameter_groups":[
        {
            "name": "boolean_group",
            "desc": "This is the presentation group for bools",
            "priority_id": 1,
            "presentation_order": ["peril_wind", "peril_surge"],
            "collapsible": true,
            "default_collapsed": false
        },
        {
            "name": "data_param_group",
            "desc": "This is the presentation group for other types",
            "priority_id": 2,
            "presentation_order": ["dictionary_option", "option_list", "option_str"]
        }
      ],
      "dropdown_parameters":[
          {
             "name":"dropdown_option_1",
             "default":"s_hazard",
             "desc": "Dropdown Option list for <something>",
             "options":[
                {"id":"s_hazard", "desc":"Simulated Hazard tooltip"},
                {"id":"o_hazard", "desc":"Observed Hazard tooltip"}
             ]
          }
      ],
      "loss_methodology_notes": {
         "ground_up_loss_capping": {
            "gul_alloc_rule": 2,
            "description": "Ground-up losses from each sub-peril (pluvial, fluvial, coastal) are calculated separately and capped at coverage TIV; location-level damage from multiple perils uses the maximum sub-peril loss to avoid double counting."
         },
         "correlation_methodology": "Hazard uncertainty applies only to coarse-geocoded locations; coverage correlation 1.0, sub-peril correlation 0.0, within-event correlation 0.0. Damage uncertainty uses a Beta distribution with finite probability of nil/100% loss; coverage and sub-peril correlation 1.0, within-event correlation 0.3."
      }
   },
   "data_settings":{
        "supported_oed_versions": ["1.5", "2.0"],
        "model_data_version": "1.0.0",
        "keys_data_version": "1.0.0",
        "worker_image": "coreoasis/model_worker",
        "worker_version":"1.12.0",
        "uses_model_files": true,
        "countries": ["UK", "US"],
        "mandatory_fields": ["AreaName", "PostalCode", "OccupancyCode"],
        "supported_coverages": [
            {"oed_field": "BuildingTIV", "supported": true},
            {"oed_field": "ContentsTIV", "supported": true},
            {
               "oed_field": "BITIV",
               "supported": true,
               "notes": "Represents BI for industrial/commercial and Additional Living Expenses for residential. Must be an annualised figure; if BIPOI != 365 the model scales BITIV by BIPOI/365."
            },
            {
               "oed_field": "OtherTIV",
               "supported": false,
               "notes": "Not supported, e.g. motor, appurtenant structures."
            }
        ],
        "geographic_extent_notes": "60 degrees S to 80 degrees N, excludes Greenland and Antarctica.",
        "geographic_exclusions": ["Greenland", "Antarctica"],
        "geographic_schemes_supported": [
            {
               "scheme": "Coordinate",
               "oed_fields": ["Latitude", "Longitude"],
               "notes": "Assigns the relevant 1 arcsecond (~30m) hazard grid cell."
            },
            {
               "scheme": "PostalCode",
               "oed_fields": ["PostalCode"]
            },
            {
               "scheme": "GeogSchemeX",
               "oed_fields": ["GeogSchemeX", "GeogNameX"],
               "scheme_codes": ["FTM1"],
               "notes": "FTM1 supports both postcode and city-level disaggregation."
            }
        ],
        "field_behaviour": [
            {
               "oed_field": "OccupancyCode",
               "role": "modifier",
               "excluded_values": [
                  {"value": "1250", "effect": "no_loss", "notes": "Transportation and Auto"},
                  {"value": "1251", "effect": "no_loss", "notes": "Transportation and Auto"},
                  {"value": "1255", "effect": "no_loss", "notes": "Transportation and Auto"},
                  {"value": "1260", "effect": "no_loss", "notes": "Transportation and Auto"},
                  {"value": "3000-3999", "effect": "no_loss", "notes": "Offshore"}
               ]
            },
            {
               "oed_field": "FloodDefenseHeight",
               "role": "modifier",
               "requires_companion_field": "FloodDefenseHeightUnit",
               "excluded_values": [
                  {"value": "> 10 metres", "effect": "no_loss"}
               ]
            },
            {
               "oed_field": "BIPOI",
               "role": "modifier",
               "excluded_values": [
                  {"value": "> 1095", "effect": "capped", "notes": "Capped at 1095 days"}
               ]
            }
        ],
        "out_of_scope": [
            {"item": "Allocated Loss Adjustment Expenses (ALAE)", "category": "loss_element"},
            {"item": "Demand surge / Post Loss Amplification (PLA)", "category": "loss_element"},
            {"item": "OtherTIV coverage", "category": "coverage"}
        ],
        "additional_assets": [
            {
               "name": "catresponsedata",
               "version": "1.0",
               "path": "model_data/catresponse/"
            }
        ],
        "datafile_selectors":[
             {
               "name": "model_data_file_option_1",
               "desc": "Additional model data file for foo",
               "model_id": 4,
               "allow_multiple": true,
               "search_filters": [
                   {
                       "user": "admin",
                       "filename": "file_model_data.txt",
                       "filename__contains": "txt",
                       "file_description": "File for XYZ",
                       "file_description__contains": "YX",
                       "content_type": "text/plain",
                       "content_type__contains": "text"
                   }
               ]
            }
        ]
   },
   "lookup_settings":{
      "supported_perils":[
         {
            "id":"WSS",
            "desc":"Single Peril: Storm Surge"
         },
         {
            "id":"WTC",
            "desc":"Single Peril: Tropical Cyclone"
         },
         {
            "id":"WW1",
            "desc":"Group Peril: Windstorm with storm surge"
         },
         {
            "id":"WW2",
            "desc":"Group Peril: Windstorm w/o storm surge"
         }
      ]
   }
}
